# Kaze — opciones comunes de compilación de Firefox.
# surfer reemplaza ${binName}, ${brandingDir} y ${changeset}.

ac_add_options --enable-application=browser
ac_add_options --with-app-name=${binName}
ac_add_options --with-app-basename=Kaze
ac_add_options --with-distribution-id=app.kaze
ac_add_options --with-l10n-base="${topsrcdir}/browser/locales"

export MOZ_APP_BASENAME=Kaze
export MOZ_BRANDING_DIRECTORY=${brandingDir}
export MOZ_OFFICIAL_BRANDING_DIRECTORY=${brandingDir}
export MOZ_SOURCE_REPO=https://github.com/Saerling/kaze
export MOZ_SOURCE_CHANGESET=${changeset}

# Sin telemetría, sin informes de salud, sin estudios.
mk_add_options MOZ_DATA_REPORTING=
mk_add_options MOZ_SERVICES_HEALTHREPORT=
mk_add_options MOZ_TELEMETRY_REPORTING=
ac_add_options --disable-crashreporter
ac_add_options --disable-updater

# Optimización (se usa siempre: una compilación sin optimizar es lenta y pesada).
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-tests
ac_add_options --disable-geckodriver
ac_add_options --enable-rust-simd

if test "$KAZE_RELEASE"; then
  # Builds oficiales: optimización entre lenguajes (C++ ↔ Rust). Tarda más en compilar.
  ac_add_options --enable-release
  export MOZ_LTO=cross,thin
  ac_add_options --enable-lto=cross,thin
  mk_add_options MOZILLA_OFFICIAL=1
  export MOZILLA_OFFICIAL=1
fi

# Si el PC se queda sin RAM al compilar, baja los trabajos en paralelo:
# mk_add_options MOZ_MAKE_FLAGS="-j4"

if test "$SCCACHE_GHA_ENABLED" = "true"; then
  ac_add_options --with-ccache=sccache
fi
