# Kaze para Windows (x86-64). Para compilar en Windows usa la terminal de MozillaBuild.

ac_add_options --target=x86_64-pc-windows-msvc
ac_add_options --enable-eme=widevine,wmfcdm

# Compilación cruzada desde Linux (la que usa GitHub Actions).
if test "$KAZE_CROSS_COMPILING"; then
  export WINSYSROOT="$HOME/win-cross/vs"
  export WINE="$HOME/win-cross/wine/bin/wine"
  export WINEDEBUG=-all
  export CROSS_BUILD=1
  CROSS_COMPILE=1
  ac_add_options --enable-bootstrap
fi
