{
  "manifest_version": 2,
  "name": "Kaze",
  "version": "1.0",
  "description": "Funciones internas de Kaze: modo Lector.",
  "browser_specific_settings": { "gecko": { "id": "interno@kaze.app" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["Readability-readerable.js", "Readability.js", "lector.js"],
      "run_at": "document_idle"
    }
  ]
}
